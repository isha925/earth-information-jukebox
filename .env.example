# Copy this file to .env and fill in your keys.

# REQUIRED for Gemini voice PA:
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Optional: used for real Nepali/Japanese/etc. spoken audio (browser often has no Nepali voice)
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# OPTIONAL for api.nasa.gov services (APOD, some Earth endpoints).
# NOT required for NASA POWER, GIBS, GISTEMP CSV, or SVS EIC frames used by this app.
# Create at https://api.nasa.gov/ (sign up, then generate key)
# NASA_API_KEY=your-nasa-api-key

# Optional server port (default 3000)
# PORT=3000
