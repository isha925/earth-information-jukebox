# Copy this file to .env and fill in your key.
# Create a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Required model for current Google AI Studio accounts:
GEMINI_MODEL=gemini-3.8-flash

# Optional: port for the web server (default: 3000)
# PORT=3000

# NASA POWER and GISTEMP endpoints used by this app do not require API keys.
